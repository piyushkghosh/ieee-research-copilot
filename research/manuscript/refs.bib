% refs.bib — bibliography for the manuscript.
% Rules (checklist J2/J3):
%   - Every entry must be verified against the publisher or DOI resolver.
%   - Required fields: author, title, booktitle/journal, year, pages, doi.
%   - Unverifiable entries stay here with a "% UNVERIFIED: <reason>" line ABOVE them
%     and are reported by the references agent. Never invent metadata.
%   - In-text citations are \cite{key}; IEEEtran numbers them by first appearance (D5).
%
% Copy the shape below for a new entry. BibTeX still parses blocks that begin with an
% entry-type keyword, so keep real entries uncommented and duplicate this block by hand.
% Block shape (INPROCEEDINGS is a literal bibtex entry type, written without a leading symbol):
%
% INPROCEEDINGS{example2024,
%   author    = {A. Author and B. Author},
%   title     = {A Specific Paper Title},
%   booktitle = {Proc. IEEE Int. Conf. Example},
%   year      = {2024},
%   pages     = {1--6},
%   doi       = {10.1109/EXAMPLE.2024.000001}
% }
%
% UNVERIFIED example (kept, flagged, not silently accepted):
% % UNVERIFIED: DOI not resolvable on 2026-10-28 — verify manually
% ARTICLE{exampleUnverified,
%   author = {C. Author},
%   title  = {Unconfirmed Title},
%   journal = {Some Journal},
%   year   = {2023}
% }
